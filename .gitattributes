# Preserve exact source/evidence bytes: historical integrity locks include their hashes.
# Do not silently normalize already-frozen files on checkout or add.
* -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Matplotlib SVG path formatting has intentional trailing spaces.
*.svg whitespace=-blank-at-eol,cr-at-eol
*.png binary
